# Public HTTPS URL pointing to this Evolution instance, e.g. https://wa.example.com
EVOLUTION_PUBLIC_URL=https://wa.example.com
EVOLUTION_PORT=8080

# Generate long random values before deployment.
EVOLUTION_API_KEY=replace-with-a-long-random-api-key
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

POSTGRES_DB=evolution
POSTGRES_USER=evolution

# SocialPilot itself does not call Evolution from the browser, so this can stay restrictive.
EVOLUTION_CORS_ORIGIN=https://socialpilot-tarek-s-projects67.vercel.app
